---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { proyectos } from '../../data/proyectos.js';

export function getStaticPaths() {
  return (proyectos || []).map((proyecto) => ({
    params: { slug: proyecto.slug },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
---

<BaseLayout
  title={`${proyecto.title} | Jcham0`}
  description={`${proyecto.title}: detalle del proyecto, tecnologías y funcionalidades desarrolladas por Jcham0.`}
>
  <SiteHeader />

  <main class="container project-detail" id="main-content">
    <header class="page-header detail-header">
      <p class="eyebrow">Proyecto</p>
      <h1>{proyecto.title}</h1>
      <p>{proyecto.description}</p>
      <a class="button primary" href={proyecto.repoUrl} target="_blank" rel="noreferrer">
        Ver código en GitHub
      </a>
    </header>

    <section class="detail-section" data-reveal>
      <h2>Problema</h2>
      <p>{proyecto.problema}</p>
    </section>

    <section class="detail-section" data-reveal>
      <h2>Solución</h2>
      <p>{proyecto.solucion}</p>
    </section>

    <section class="detail-section" data-reveal>
      <h2>Tecnologías</h2>
      <div class="chip-list">
        {(proyecto.tecnologias || []).map((tech) => (
          <span class="chip">{tech}</span>
        ))}
      </div>
    </section>

    <section class="detail-section" data-reveal>
      <h2>Funcionalidades clave</h2>
      <ul class="feature-list">
        {(proyecto.funcionalidades || []).map((feature) => (
          <li>{feature}</li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
